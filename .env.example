# CureConnect needs no API keys.
#
# Doctor search runs on OpenStreetMap through the Overpass API: free, keyless,
# and nothing to bill. The Google Places key that used to live here is no longer
# read by any code in this project - see docs/places_osm.md for why.
#
# This file is kept as the place to document future secrets. Copy it to .env
# when that day comes, and never commit .env.

# Optional, not a secret: how many POST /recommend calls one IP may make per
# minute (default 10). Set it if 10 is wrong for your demo. app/ratelimit.py
# reads it.
RATE_LIMIT_PER_MINUTE=10
